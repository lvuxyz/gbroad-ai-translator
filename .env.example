# ==============================================================================
# Windows AI Translation Tool Environment Configuration
# ==============================================================================
# Note: You can also configure these keys securely through the Settings GUI,
# which stores them directly in Windows Credential Manager.
# ==============================================================================

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (https://platform.openai.com/)
OPENAI_API_KEY=

# Google Cloud Translation API Key (optional - free endpoint used if empty)
GOOGLE_API_KEY=

# Default Translation Provider: gemini | openai | google
DEFAULT_PROVIDER=gemini

# Default Target Language: en | vi | zh-CN | zh-TW | ja | ko | fr | de | es | th
DEFAULT_TARGET_LANGUAGE=en

# Default Source Language (auto for Auto Detect)
DEFAULT_SOURCE_LANGUAGE=auto

# Translation Mode: translate | rewrite
DEFAULT_MODE=translate

# AI Rewrite Style: natural | formal | casual | polish
DEFAULT_REWRITE_STYLE=natural

# Privacy Mode: true | false (disables database history and hides text from logs)
PRIVACY_MODE=false

# Automatically restore clipboard contents after in-place replacement: true | false
RESTORE_CLIPBOARD=true

# Show floating toast notification on translation: true | false
SHOW_NOTIFICATIONS=true
